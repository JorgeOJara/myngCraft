<%- include('../partials/head', { adminPage: true }) %>
<body class="admin-body">
<%- include('../partials/admin-header') %>
  <div class="admin-page-heading"><div><a class="admin-back" href="/admin">← Owner home</a><h1>Store settings</h1><p>Change the words customers see and the basic delivery costs.</p></div></div>
  <% if (saved) { %><div class="admin-alert alert-success">✓ Your store settings were saved.</div><% } %>
  <form class="settings-form" method="post" action="/admin/settings">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <section class="form-card"><div class="form-card-number">1</div><div class="form-card-heading"><h2>Store name and top message</h2><p>The announcement appears in the narrow bar above the menu.</p></div><div class="large-fields"><label>Store name<input name="store_name" value="<%= settings.store_name %>" required></label><label>Short description<input name="tagline" value="<%= settings.tagline %>"></label><label>Top announcement<input name="announcement" value="<%= settings.announcement %>" placeholder="Example: Free shipping over $75"></label></div></section>
    <section class="form-card"><div class="form-card-number">2</div><div class="form-card-heading"><h2>Home page welcome</h2><p>These words are the first thing customers see.</p></div><div class="large-fields"><label>Small heading<input name="hero_eyebrow" value="<%= settings.hero_eyebrow %>"></label><label>Main heading<input name="hero_heading" value="<%= settings.hero_heading %>"></label><label>Welcome message<textarea name="hero_text" rows="4"><%= settings.hero_text %></textarea></label></div></section>
    <section class="form-card"><div class="form-card-number">3</div><div class="form-card-heading"><h2>Your story</h2><p>A short personal note builds trust with customers.</p></div><div class="large-fields"><label>Story heading<input name="story_heading" value="<%= settings.story_heading %>"></label><label>Story text<textarea name="story_text" rows="6"><%= settings.story_text %></textarea></label></div></section>
    <section class="form-card"><div class="form-card-number">4</div><div class="form-card-heading"><h2>Contact details</h2><p>Leave either one blank if you do not want it shown.</p></div><div class="money-stock-grid"><label>Store email<input name="contact_email" type="email" value="<%= settings.contact_email %>" placeholder="hello@example.com"></label><label>Phone number<input name="contact_phone" type="tel" value="<%= settings.contact_phone %>" placeholder="(555) 555-5555"></label></div></section>
    <section class="form-card"><div class="form-card-number">5</div><div class="form-card-heading"><h2>Delivery and checkout</h2><p>Enter zero if shipping is always free.</p></div><div class="money-stock-grid"><label>Free shipping when order reaches<div class="money-input"><b>$</b><input name="free_shipping" inputmode="decimal" value="<%= (Number(settings.free_shipping_cents) / 100).toFixed(2) %>"></div></label><label>Shipping cost below that amount<div class="money-input"><b>$</b><input name="flat_shipping" inputmode="decimal" value="<%= (Number(settings.flat_shipping_cents) / 100).toFixed(2) %>"></div></label></div><div class="large-fields single-field"><label>Checkout message<textarea name="checkout_note" rows="4"><%= settings.checkout_note %></textarea></label></div></section>
    <div class="sticky-save-bar"><p><strong>All done?</strong> Your changes appear as soon as you save.</p><a href="/admin" class="quiet-button">Cancel</a><button class="admin-primary-button save-item-button" type="submit">✓ Save store settings</button></div>
  </form>
<%- include('../partials/admin-footer') %>
