<%- include('../partials/head', { adminPage: true }) %>
<body class="admin-login-body">
  <main class="login-page">
    <section class="login-card">
      <a class="login-brand" href="/"><span>M</span><strong><%= settings.store_name %></strong></a>
      <p class="admin-eyebrow">PRIVATE OWNER AREA</p>
      <h1>Welcome back, Myng.</h1>
      <p class="login-intro">Enter your store password to manage items and orders.</p>
      <% if (error) { %><div class="admin-alert alert-error" role="alert">That password wasn’t right. Please try again.</div><% } %>
      <% if (locked) { %><div class="admin-alert alert-error" role="alert">There were too many tries. Please wait 15 minutes, then try again.</div><% } %>
      <form class="login-form" method="post" action="/admin/login">
        <label for="password">Store password</label>
        <div class="password-field"><input id="password" name="password" type="password" maxlength="256" autocomplete="current-password" autofocus required><button type="button" data-password-toggle aria-label="Show password">Show</button></div>
        <button class="admin-primary-button admin-full-button" type="submit">Open my store</button>
      </form>
      <a class="back-to-shop" href="/">← Back to the shop</a>
    </section>
    <aside class="login-picture" aria-hidden="true"><img src="/images/myngcraft-hero.png" alt=""><p><span>✦</span> A simple place to care for your shop.</p></aside>
  </main>
</body>
</html>
