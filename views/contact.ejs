<%- include('partials/head', { adminPage: false }) %>
<body>
<%- include('partials/header') %>
<main>
  <section class="contact-section">
    <div class="shell contact-grid">
      <div class="contact-copy reveal">
        <p class="eyebrow">LET'S TALK</p>
        <h1>Questions, custom ideas, or just want to say hello?</h1>
        <p>Send a note about a piece, an order, or something special you have in mind. Myng will get back to you personally.</p>
        <div class="contact-details">
          <% if (settings.contact_email) { %><a href="mailto:<%= settings.contact_email %>"><span>✉</span><p><small>Email</small><strong><%= settings.contact_email %></strong></p></a><% } %>
          <% if (settings.contact_phone) { %><a href="tel:<%= settings.contact_phone %>"><span>☎</span><p><small>Phone</small><strong><%= settings.contact_phone %></strong></p></a><% } %>
          <div><span>♡</span><p><small>A real person replies</small><strong>Your note goes directly to Myng</strong></p></div>
        </div>
      </div>
      <div class="contact-card reveal reveal-late">
        <% if (sent) { %>
          <div class="contact-success"><span>✓</span><h2>Your note is on its way.</h2><p>Thank you for reaching out. Myng will reply as soon as she can.</p><a class="button button-outline" href="/shop">Browse while you wait</a></div>
        <% } else { %>
          <h2>Send Myng a note</h2>
          <p class="form-intro">All three fields are needed.</p>
          <% if (errors.length) { %><div class="form-errors" role="alert"><strong>Please check the form:</strong><ul><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul></div><% } %>
          <form class="contact-form" method="post" action="/contact">
            <label for="contact-name">Your name</label>
            <input id="contact-name" name="name" value="<%= values.name || (customer ? `${customer.first_name} ${customer.last_name}` : '') %>" autocomplete="name" required>
            <label for="contact-email">Email address</label>
            <input id="contact-email" name="email" type="email" value="<%= values.email || (customer ? customer.email : '') %>" autocomplete="email" required>
            <label for="contact-message">How can Myng help?</label>
            <textarea id="contact-message" name="message" rows="6" required><%= values.message || '' %></textarea>
            <button class="button button-primary" type="submit">Send my message</button>
          </form>
        <% } %>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
