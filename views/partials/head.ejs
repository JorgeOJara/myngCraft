<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#3f1d2c">
  <meta name="description" content="<%= settings.tagline %>">
  <% if (customer) { %>
    <meta name="myng-customer-id" content="<%= customer.id %>">
    <meta name="myng-customer-csrf" content="<%= customerCsrf %>">
  <% } %>
  <title><%= pageTitle %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
  <% if (typeof adminPage !== 'undefined' && adminPage) { %>
    <link rel="stylesheet" href="/css/admin.css?v=20260905-4">
    <script src="/js/admin.js?v=20260905-4" defer></script>
  <% } else { %>
    <link rel="stylesheet" href="/css/store.css?v=20260905-4">
    <script src="/js/store.js?v=20260905-4" defer></script>
  <% } %>
</head>
