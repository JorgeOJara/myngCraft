<article class="product-card">
  <a class="product-card-image" href="/product/<%= product.slug %>">
    <img src="<%= imageForProduct(product) %>" alt="<%= product.name %>" loading="lazy">
    <% if (product.featured) { %><span class="product-badge">Myng's pick</span><% } %>
  </a>
  <% if (customer) { %>
    <form class="favorite-form" method="post" action="/account/favorites/<%= product.id %>/toggle">
      <input type="hidden" name="_csrf" value="<%= customerCsrf %>">
      <input type="hidden" name="return_to" value="<%= currentPath %>">
      <button type="submit" class="favorite-button <%= favoriteIds.has(product.id) ? 'is-favorite' : '' %>" aria-label="<%= favoriteIds.has(product.id) ? 'Remove' : 'Add' %> <%= product.name %> <%= favoriteIds.has(product.id) ? 'from' : 'to' %> favorites"><%= favoriteIds.has(product.id) ? '♥' : '♡' %></button>
    </form>
  <% } else { %>
    <a class="favorite-button" href="/account/sign-in?return=<%= encodeURIComponent(currentPath) %>" aria-label="Sign in to save <%= product.name %> as a favorite">♡</a>
  <% } %>
  <div class="product-card-copy">
    <p class="product-category"><%= product.category %></p>
    <h3><a href="/product/<%= product.slug %>"><%= product.name %></a></h3>
    <div class="product-card-row">
      <span class="product-price"><%= money(product.price_cents) %></span>
      <% if (Number.isInteger(product.price_cents) && product.price_cents > 0 && product.stock_quantity > 0) { %>
        <button class="round-add" type="button"
          data-add-to-cart
          data-product-id="<%= product.id %>"
          data-product-name="<%= product.name %>"
          data-product-price="<%= product.price_cents %>"
          data-product-image="<%= imageForProduct(product) %>"
          data-product-slug="<%= product.slug %>"
          aria-label="Add <%= product.name %> to bag">+</button>
      <% } else { %>
        <span class="availability"><%= product.stock_quantity <= 0 ? 'Coming soon' : 'Ask Myng' %></span>
      <% } %>
    </div>
  </div>
</article>
