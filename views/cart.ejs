<%- include('partials/head', { adminPage: false }) %>
<body>
<%- include('partials/header') %>
<main>
  <section class="bag-section">
    <div class="shell">
      <div class="bag-heading"><div><p class="eyebrow">YOUR BAG</p><h1>A few lovely things.</h1></div><a class="text-link" href="/shop">Keep shopping <span>→</span></a></div>
      <div data-cart-page>
        <div class="cart-loading">Opening your bag…</div>
      </div>
      <template id="cart-item-template">
        <article class="cart-item">
          <a class="cart-item-image" data-item-link><img data-item-image alt=""></a>
          <div class="cart-item-copy">
            <p class="product-category">HANDMADE PIECE</p>
            <h2><a data-item-link data-item-name></a></h2>
            <p data-item-price></p>
            <button type="button" class="remove-link" data-remove-item>Remove</button>
          </div>
          <div class="cart-quantity"><label>Quantity<select data-item-quantity></select></label></div>
          <strong class="cart-line-total" data-item-total></strong>
        </article>
      </template>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
