<%- include('../partials/head', { adminPage: false }) %>
<body>
<%- include('../partials/header') %>
<main class="account-page">
  <section class="account-welcome">
    <div class="shell">
      <p class="eyebrow">MY ACCOUNT</p>
      <h1>Hello, <%= customer.first_name %>.</h1>
      <p>Here’s everything you’ve saved and everything Myng is working on for you.</p>
    </div>
  </section>
  <div class="shell account-shell">
    <%- include('nav') %>
    <section class="account-stats" aria-label="Account summary">
      <a href="/account/orders"><span>□</span><p><strong><%= stats.currentOrders %></strong><small>Current <%= stats.currentOrders === 1 ? 'order' : 'orders' %></small></p></a>
      <a href="/account/favorites"><span>♡</span><p><strong><%= stats.favorites %></strong><small>Saved <%= stats.favorites === 1 ? 'favorite' : 'favorites' %></small></p></a>
      <a href="/cart"><span>⌁</span><p><strong><%= stats.bagItems %></strong><small><%= stats.bagItems === 1 ? 'Item' : 'Items' %> in your bag</small></p></a>
      <a href="/account/orders"><span>✉</span><p><strong><%= stats.unreadMessages %></strong><small>Unread <%= stats.unreadMessages === 1 ? 'message' : 'messages' %></small></p></a>
    </section>

    <section class="account-section-block">
      <div class="account-section-heading"><div><p class="eyebrow">RIGHT NOW</p><h2>Your current orders</h2></div><a class="text-link" href="/account/orders">See all orders <span>→</span></a></div>
      <% if (currentOrders.length) { %><div class="customer-order-grid"><% currentOrders.forEach((order) => { %><%- include('order-card', { order }) %><% }) %></div>
      <% } else { %><div class="account-empty"><span>□</span><div><h3>No active orders right now.</h3><p>When you order something, you’ll follow every step here.</p></div><a class="button button-outline" href="/shop">Visit the shop</a></div><% } %>
    </section>

    <section class="account-section-block">
      <div class="account-section-heading"><div><p class="eyebrow">HEARTED BY YOU</p><h2>Your favorites</h2></div><a class="text-link" href="/account/favorites">See all favorites <span>→</span></a></div>
      <% if (favorites.length) { %><div class="product-grid"><% favorites.forEach((product) => { %><%- include('../partials/product-card', { product }) %><% }) %></div>
      <% } else { %><div class="account-empty"><span>♡</span><div><h3>Nothing saved yet.</h3><p>Tap the heart on any piece you’d like to remember.</p></div><a class="button button-outline" href="/shop">Find a favorite</a></div><% } %>
    </section>

    <% if (pastOrders.length) { %><section class="account-section-block"><div class="account-section-heading"><div><p class="eyebrow">ORDER HISTORY</p><h2>Previous orders</h2></div><a class="text-link" href="/account/orders#history">See full history <span>→</span></a></div><div class="customer-order-grid"><% pastOrders.forEach((order) => { %><%- include('order-card', { order }) %><% }) %></div></section><% } %>
  </div>
</main>
<%- include('../partials/footer') %>
