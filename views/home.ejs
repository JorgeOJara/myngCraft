<%- include('partials/head', { adminPage: false }) %>
<body>
<%- include('partials/header') %>

<main>
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow"><%= settings.hero_eyebrow %></p>
        <h1><%= settings.hero_heading %></h1>
        <p class="hero-lede"><%= settings.hero_text %></p>
        <div class="hero-actions">
          <a class="button button-primary" href="/shop">Shop the collection</a>
          <a class="text-link" href="/about">Meet the maker <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-detail" aria-label="Shop qualities">
          <span><i aria-hidden="true">✦</i> Small-batch</span>
          <span><i aria-hidden="true">♡</i> Gift-ready</span>
          <span><i aria-hidden="true">⌁</i> Made with care</span>
        </div>
      </div>
      <div class="hero-visual reveal reveal-late">
        <div class="hero-image-wrap">
          <img src="/images/myngcraft-hero.png" alt="Handmade jewelry, pottery, and gift-ready pieces arranged on a bright studio table">
        </div>
        <div class="hero-seal" aria-hidden="true"><span>made</span><strong>with heart</strong><span>by Myng</span></div>
        <div class="hero-caption"><span>01</span><p>Small details.<br>Lovely stories.</p></div>
      </div>
    </div>
  </section>

  <section class="promise-bar" aria-label="Shopping benefits">
    <div class="shell promise-grid">
      <div><span class="promise-icon">♧</span><p><strong>Made in small batches</strong><small>Thoughtful pieces, never mass produced</small></p></div>
      <div><span class="promise-icon">⌁</span><p><strong>Wrapped with care</strong><small>Ready to make someone smile</small></p></div>
      <div><span class="promise-icon">♡</span><p><strong>Questions are welcome</strong><small>Talk directly with Myng</small></p></div>
    </div>
  </section>

  <section class="section collections-section">
    <div class="shell">
      <div class="section-heading split-heading reveal">
        <div><p class="eyebrow">FIND YOUR FAVORITE</p><h2>Made for little moments.</h2></div>
        <p>Browse by what feels right—something to wear, a warm detail for home, or a gift chosen from the heart.</p>
      </div>
      <div class="collection-grid">
        <% collections.forEach((collection, index) => { %>
          <a class="collection-card reveal" href="/shop?category=<%= encodeURIComponent(collection.name) %>" style="--delay: <%= index * 70 %>ms">
            <img src="<%= collection.image %>" alt="<%= collection.name %> collection" loading="lazy">
            <span class="collection-shade"></span>
            <span class="collection-number">0<%= index + 1 %></span>
            <span class="collection-copy"><small><%= collection.note %></small><strong><%= collection.name %></strong><i aria-hidden="true">↗</i></span>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section featured-section">
    <div class="shell">
      <div class="section-heading centered reveal">
        <p class="eyebrow">FROM MYNG'S WORKTABLE</p>
        <h2>Pieces worth keeping close.</h2>
        <p>Handmade finds, shared as they become ready.</p>
      </div>
      <% if (featuredProducts.length) { %>
        <div class="product-grid product-grid-featured">
          <% featuredProducts.forEach((product) => { %><%- include('partials/product-card', { product }) %><% }) %>
        </div>
      <% } else { %>
        <div class="store-empty"><span>✦</span><h3>Something lovely is taking shape.</h3><p>New pieces will appear here as soon as Myng finishes them.</p></div>
      <% } %>
      <div class="center-action"><a class="button button-outline" href="/shop">See everything in the shop</a></div>
    </div>
  </section>

  <section class="story-section">
    <div class="shell story-grid">
      <div class="story-collage reveal">
        <div class="story-main-image"><img src="/images/myngcraft-cat-jewelry.jpg" alt="A handmade jewelry piece styled in soft natural light" loading="lazy"></div>
        <div class="story-small-image"><img src="/images/myngcraft-cat-accessories.jpg" alt="Handmade accessories on a studio table" loading="lazy"></div>
        <blockquote>“The sweetest gifts feel like they were chosen just for you.”</blockquote>
      </div>
      <div class="story-copy reveal reveal-late">
        <p class="eyebrow">A NOTE FROM THE MAKER</p>
        <h2><%= settings.story_heading %></h2>
        <p><%= settings.story_text %></p>
        <p class="signature">Myng</p>
        <a class="text-link" href="/about">Read our little story <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="newsletter-section" id="little-notes">
    <div class="shell newsletter-card reveal">
      <div><p class="eyebrow">LITTLE NOTES FROM THE STUDIO</p><h2>Be first to see what’s new.</h2></div>
      <div>
        <% if (joined) { %>
          <p class="success-note">You’re on the list—thank you! ♡</p>
        <% } else { %>
          <form class="newsletter-form" method="post" action="/newsletter">
            <label class="sr-only" for="newsletter-email">Email address</label>
            <input id="newsletter-email" name="email" type="email" placeholder="Your email address" autocomplete="email" required>
            <button type="submit" aria-label="Join email list">→</button>
          </form>
          <small>Occasional updates, made with care. No clutter.</small>
        <% } %>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
